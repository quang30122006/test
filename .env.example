# Kết nối PostgreSQL (Neon / Vercel Storage) khi triển khai Cloud
# Nếu bỏ trống ở máy local, hệ thống mặc định dùng SQLite tại backend/data/agribank_kpi_3p.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Khóa bí mật ký JWT (BẮT BUỘC đặt chuỗi ngẫu nhiên >= 32 ký tự khi lên Vercel)
AGRIBANK_KPI_JWT_SECRET=thay-bang-chuoi-bi-mat-ngau-nhien-it-nhat-32-ky-tu

# Tắt danh sách chọn nhanh cán bộ công khai khi chưa đăng nhập (false = an toàn cho web public)
PUBLIC_STAFF_DIRECTORY=false

# Tùy chọn mở rộng CORS nếu gọi API từ domain khác (phân cách bằng dấu phẩy)
# AGRIBANK_CORS_ORIGINS=https://ten-web-cua-ban.vercel.app

